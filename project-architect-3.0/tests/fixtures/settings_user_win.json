{
  "cleanupPeriodDays": 3650,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)"
    ]
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash C:/Users/you/.claude/ctx_guard.sh",
            "timeout": 5,
            "statusMessage": "ctx guard"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash C:/Users/you/.claude/statusline.sh"
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "low"
    },
    "claude-opus-4-6": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "latest",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": false,
  "todoFeatureEnabled": true
}
