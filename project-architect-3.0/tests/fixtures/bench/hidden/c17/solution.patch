diff --git a/shelf/isbn.py b/shelf/isbn.py
index 08712bf..0dc21d3 100644
--- a/shelf/isbn.py
+++ b/shelf/isbn.py
@@ -32,6 +32,18 @@ def is_valid_isbn(raw):
     return is_valid_isbn10(s) if len(s) == 10 else is_valid_isbn13(s)
 
 
+def to_isbn13(raw):
+    """Canonical ISBN-13 for a valid ISBN-10 or ISBN-13; raises ValueError."""
+    s = normalize_isbn(raw)
+    if is_valid_isbn13(s):
+        return s
+    if not is_valid_isbn10(s):
+        raise ValueError(f"invalid ISBN: {raw!r}")
+    body = "978" + s[:9]
+    total = sum(int(c) * (1 if i % 2 == 0 else 3) for i, c in enumerate(body))
+    return body + str((10 - total % 10) % 10)
+
+
 def check_isbn(raw):
     """Deprecated since 0.3: ISBN-10 only and ignores spaces badly. Use is_valid_isbn."""
     s = raw.replace("-", "")
