+def _upgrade_v1(data):
+    """Rewrite a format-1 (shelf 0.2) document as format 2."""
+    books = [dict({"copies": 1, "tags": []}, **b) for b in data["books"]]
+    members = [dict({"kind": "standard", "active": True}, **m) for m in data["members"]]
+    loans = []
+    for loan in data["loans"]:
+        loan = dict({"renewals": 0}, **loan)
+        loan["isbn"] = normalize_isbn(loan["isbn"])   # 0.2 kept ISBNs as typed; the desk matches loans by the catalog key
+        for key in ("start", "due", "returned"):
+            if loan.get(key):
+                loan[key] = _v1_date(loan[key])
+        loans.append(loan)
+    return {"format": FORMAT, "books": books, "members": members, "loans": loans}
+
