+    def search(self, text, *, tag=None):
+        """Books where every word of text occurs in the title or the author (case-insensitive).
+
+        Optional tag filter; sorted by title, ties by ISBN; blank text finds nothing.
+        """
+        words = text.lower().split()
+        if not words:
+            return []
+        hits = []
+        for book in self._books.values():
+            if tag is not None and tag not in book.tags:
+                continue
+            fields = (book.title.lower(), book.author.lower())
+            if all(any(word in f for f in fields) for word in words):
+                hits.append(book)
+        return sorted(hits, key=lambda b: (b.title.lower(), b.isbn))
 
     def by_tag(self, tag):
         return sorted((b for b in self._books.values() if tag in b.tags), key=lambda b: b.isbn)
