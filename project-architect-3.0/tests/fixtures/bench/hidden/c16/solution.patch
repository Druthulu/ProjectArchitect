+def author_ranking(desk, n=10):
+    """Top n (author, loans) over all loans ever; spellings grouped by author_key."""
+    display = {}
+    for book in desk.catalog:   # ascending ISBN, so the first spelling seen wins
+        display.setdefault(author_key(book.author), book.author)
+    counts = Counter(author_key(desk.catalog.get(loan.isbn).author) for loan in desk.loans)
+    ranked = sorted(((display[key], count) for key, count in counts.items()),
+                    key=lambda kv: (-kv[1], kv[0]))
+    return ranked[:n]
