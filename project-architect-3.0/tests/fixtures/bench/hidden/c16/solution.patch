+def author_key(name):
+    """Comparable form of an author name: 'Last, First' -> 'first last', lower-case, no periods."""
+    if "," in name:
+        last, first = name.split(",", 1)
+        name = f"{first} {last}"
+    return " ".join(name.replace(".", "").lower().split())
