diff --git a/shelf/fees.py b/shelf/fees.py
index 3a11d37..5555108 100644
--- a/shelf/fees.py
+++ b/shelf/fees.py
@@ -7,7 +7,7 @@ def late_fee_cents(days_late, kind="standard"):
     billable = days_late - policy.GRACE_DAYS
     if billable <= 0:
         return 0
-    return min(billable * policy.daily_fee(kind), policy.FEE_CAP_CENTS)
+    return min(billable * policy.daily_fee(kind), policy.fee_cap(kind))
 
 
 def loan_fee_cents(loan, today, kind="standard"):
@@ -15,6 +15,23 @@ def loan_fee_cents(loan, today, kind="standard"):
     return late_fee_cents(loan.days_late(today), kind)
 
 
+def outstanding_cents(desk, member_id, today=None):
+    """Fees accrued so far on a member's open loans."""
+    today = today or desk.today()
+    kind = desk.members.get(member_id).kind
+    return sum(loan_fee_cents(loan, today, kind) for loan in desk.open_loans(member_id))
+
+
+def fee_summary(desk, today=None):
+    """member_id -> outstanding cents, for members owing anything, in id order."""
+    out = {}
+    for member in desk.members:
+        cents = outstanding_cents(desk, member.member_id, today)
+        if cents:
+            out[member.member_id] = cents
+    return out
+
+
 def format_cents(cents):
     """1234 -> '$12.34'."""
     return f"${cents // 100}.{cents % 100:02d}"
