+def member_statement(desk, member_id, today=None):
+    """Text statement of a member's loans and fees as of today."""
+    today = today or desk.today()
+    member = desk.members.get(member_id)
+    lines = [f"Statement for {member.name} ({member.member_id}, {member.kind}) on {today.isoformat()}"]
+    total = 0
+    for loan in sorted(desk.history(member_id), key=lambda loan: (loan.start, loan.loan_id)):
+        title = desk.catalog.get(loan.isbn).title
+        line = f"{loan.loan_id} {title} | due {loan.due.isoformat()} | {loan.status(today)}"
+        fee = loan_fee_cents(loan, today, member.kind)
+        if fee:
+            line += f" | fee {format_cents(fee)}"
+        if loan.is_open:
+            total += fee
+        lines.append(line)
+    lines.append(f"Total due: {format_cents(total)}")
+    return lines
+
