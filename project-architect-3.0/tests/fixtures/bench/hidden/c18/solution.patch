@@ -34,3 +34,11 @@ def next_business_day(d):
     while is_weekend(d):
         d += timedelta(days=1)
     return d
+
+
+def next_open_day(d, holidays=()):
+    """d when it is a weekday and not a holiday, else the first later day that is."""
+    closed = set(holidays)
+    while is_weekend(d) or d in closed:
+        d += timedelta(days=1)
+    return d
